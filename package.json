{
  "name": "teamaligned",
  "version": "0.3.2-beta",
  "private": true,
  "description": "Local-first AI team chat desktop app.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "build": "npm run build -w apps/desktop",
    "dist:mac": "npm run dist:mac -w apps/desktop",
    "typecheck": "npm run typecheck -w apps/desktop",
    "lint": "npm run lint -w apps/desktop",
    "test:smoke": "node --test --import tsx apps/desktop/src/main/notification-policy.test.ts apps/desktop/src/renderer/src/components/chat/chat-markdown.test.tsx packages/shared/src/commands.test.ts packages/agent-runtime/src/agent-tools.test.ts packages/agent-runtime/src/deep-agent-tool-events.test.ts packages/agent-runtime/src/deep-agent.test.ts packages/agent-runtime/src/mcp-runtime.test.ts packages/agent-runtime/src/team-runtime.test.ts packages/agent-runtime/src/runtime-language.test.ts packages/agent-runtime/src/storage.test.ts packages/agent-runtime/src/web-tools.test.ts packages/agent-runtime/src/workspace-file-search.test.ts",
    "beta:check": "npm run typecheck && npm run lint && npm run test:smoke && npm run build",
    "db:generate": "npm run db:generate -w packages/agent-runtime",
    "db:migrate": "npm run db:migrate -w packages/agent-runtime",
    "docs:status": "echo 'teamaligned has moved beyond docs-first mode'"
  }
}
