{
  "name": "teamaligned",
  "version": "0.6.0-beta",
  "private": true,
  "description": "Local-first AI team chat desktop app.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "build": "npm run build -w apps/desktop",
    "dist:mac": "npm run dist:mac -w apps/desktop",
    "typecheck": "npm run typecheck -w apps/desktop",
    "lint": "npm run lint -w apps/desktop",
    "test:smoke": "node --test --import tsx apps/desktop/src/main/asset-protocol.test.ts apps/desktop/src/main/notification-policy.test.ts apps/desktop/src/main/path-policy.test.ts apps/desktop/src/renderer/src/components/chat/chat-markdown.test.tsx apps/desktop/src/renderer/src/lib/conversation-selection.test.ts apps/desktop/src/renderer/src/lib/run-progress.test.ts packages/shared/src/commands.test.ts packages/agent-runtime/src/agent-tools.test.ts packages/agent-runtime/src/deep-agent-filesystem.test.ts packages/agent-runtime/src/deep-agent-streaming.test.ts packages/agent-runtime/src/deep-agent-tool-events.test.ts packages/agent-runtime/src/deep-agent.test.ts packages/agent-runtime/src/mcp-runtime.test.ts packages/agent-runtime/src/mcp-tools.test.ts packages/agent-runtime/src/memory-compaction.test.ts packages/agent-runtime/src/persistent-checkpointer.test.ts packages/agent-runtime/src/process-env.test.ts packages/agent-runtime/src/team-runtime.test.ts packages/agent-runtime/src/tool-approval-runtime.test.ts packages/agent-runtime/src/runtime-language.test.ts packages/agent-runtime/src/runtime-timeouts.test.ts packages/agent-runtime/src/storage.test.ts packages/agent-runtime/src/web-tools.test.ts packages/agent-runtime/src/workspace-file-search.test.ts",
    "test:provider-replay": "node --import tsx scripts/team-provider-replay.ts",
    "beta:check": "npm run typecheck && npm run lint && npm run test:smoke && npm run build",
    "db:generate": "npm run db:generate -w packages/agent-runtime",
    "db:migrate": "npm run db:migrate -w packages/agent-runtime",
    "docs:status": "echo 'teamaligned has moved beyond docs-first mode'"
  }
}
